# Скопируйте в .env: cp .env.example .env
# Значения ниже подходят только для локального запуска.

# ── PostgreSQL ──
DB_NAME=low_cortisol
DB_USER=postgres
DB_PASSWORD=local_dev_password

# ── JWT: минимум 32 символа. Сгенерировать: openssl rand -hex 32 ──
JWT_SECRET=local_dev_access_secret_change_me_0123456789
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me_0123456789

NODE_ENV=development
CORS_ORIGINS=http://localhost:3001

# ── LLM и эмбеддинги: любой OpenAI-совместимый API ──
# Пустой ключ включает демо-режим: рекомендации по правилам и ML, без LLM и RAG.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Модель для текста карточек и выбора статей. gpt-4o пишет живее, но дороже.
LLM_POLISH_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000
VISION_MODEL=gpt-4o-mini
VOICE_PARSE_MODEL=gpt-4o-mini

# ── Распознавание речи ──
TRANSCRIBE_BACKEND=ml_service
WHISPER_PRELOAD=1
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Поиск продуктов через FatSecret, необязательно ──
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ── pgAdmin, необязательно: docker compose --profile tools up -d pgadmin ──
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=local_dev_password
